# ─────────────────────────────────────────────────────────────
# hfNoArte environment variables. Everything here has a free option.
# Copy to .env.local for local development; add the same keys in Vercel.
# Variables WITHOUT the NEXT_PUBLIC_ prefix never reach the browser.
# ─────────────────────────────────────────────────────────────

# Supabase (free tier) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used only by the scheduled discovery job. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used in notification links)
APP_URL=http://localhost:3000

# Protects /api/cron/* — any long random string. Vercel Cron sends it automatically.
CRON_SECRET=

# ── AI (optional; without it hfNoArte uses keyword matching, clearly labelled) ──
# Free options: Google Gemini (aistudio.google.com/apikey) or Groq (console.groq.com).
AI_PROVIDER=gemini          # gemini | groq | openai
AI_API_KEY=
# AI_MODEL=                 # optional override, e.g. gemini-2.5-flash
# AI_BASE_URL=              # optional, any OpenAI-compatible endpoint
# AI_ANALYSIS_LIMIT=12      # AI-analysed items per discovery run (free tiers are rate-limited)
# OPENAI_API_KEY=           # alternative to AI_API_KEY when AI_PROVIDER=openai

# ── Job sources (all free) ──
# Adzuna — developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Reddit — reddit.com/prefs/apps → create "script" app
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=hfNoArte/0.1 by your-reddit-username
# Bluesky — Settings → App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
# Mastodon server whose public hashtag timelines are read
MASTODON_INSTANCE=mastodon.social
# Threads — developers.facebook.com (needs threads_keyword_search approval for full search)
THREADS_ACCESS_TOKEN=
# Remotive, Remote OK, We Work Remotely, Arbeitnow, Jobicy, Himalayas,
# Hacker News and Greenhouse/Lever/Ashby company boards need no keys.

# ── Notifications (all free) ──
# Email via Resend (resend.com, free tier). Without a verified domain you can
# only send to your own Resend account email — fine for a personal tool.
RESEND_API_KEY=
EMAIL_FROM=hfNoArte <onboarding@resend.dev>
# Telegram — create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
# WhatsApp uses CallMeBot (free, personal); each user enters their key in Settings.
